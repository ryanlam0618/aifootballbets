# ============================================================
# FB AI Bets - Environment Variables Example
# ============================================================
# 複製此文件為 .env，並填入你的 API keys
# cp .env.example .env
# ============================================================

# --- API Keys ---
ODDS_API_KEY=
OPENAI_API_KEY=
GROK_API_KEY=
GEMINI_API_KEY=
API_FOOTBALL_KEY=

# --- API endpoints (optional) ---
API_BASE_URL=https://api.openai.com/v1
NETWORK_API_URL=

# --- Model names (optional) ---
MODEL_GEMINI=gemini-3-flash-preview-thinking-*
MODEL_GROK=grok-4
MODEL_GPT=gpt-5.2

# --- Paths / output (optional) ---
GDRIVE_PATH=
EXCEL_FILENAME=Betting_Records.xlsx

# --- Google Drive API upload (optional) ---
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
DEFAULT_TIMEZONE=Asia/Hong_Kong

# --- OddsPortal / OddsHarvester (24h odds source) ---
ODDSHARVESTER_DATA_DIR=OddsHarvester
ODDSHARVESTER_CMD=
ODDS_API_MAX_LEAGUES_PER_RUN=4

# --- Bankroll config (optional) ---
INITIAL_BANKROLL=2000
KELLY_FRACTION=0.75
MIN_EDGE=0.05
PAPER_MAX_BETS_PER_DAY=8
PAPER_MAX_BETS_PER_LEAGUE_PER_DAY=2
PAPER_MAX_STAKE_FRACTION_PER_BET=0.05
PAPER_MAX_LEAGUE_EXPOSURE_FRACTION_PER_DAY=0.20
PAPER_ALLOW_SYNTHETIC_ODDS=0
PAPER_FLAT_STAKE_FRACTION=0.02

# --- Layer-1 MySQL data layer (fill in .env, never commit values) ---
# Reuses the existing appdb (sofascore-backfill) instance on 127.0.0.1:3306.
# appdb_rw has SELECT/INSERT/UPDATE/DELETE/CREATE/INDEX/ALTER on appdb.*
AFB_MYSQL_HOST=127.0.0.1
AFB_MYSQL_PORT=3306
AFB_MYSQL_USER=
AFB_MYSQL_PASSWORD=
AFB_MYSQL_DATABASE=appdb
# History backend: db (matches+shotmap from MySQL) | csv (legacy files)
AFB_HISTORY_BACKEND=db
AFB_HISTORY_MIN_DATE=2015-01-01
# Dual-write mirrors (pipeline keeps sqlite internally; DB is the unified view)
AFB_SNAPSHOTS_DB=1
AFB_BETS_MIRROR_DB=1
