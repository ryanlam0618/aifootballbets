# ============================================================
# FB AI Bets - .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual Environment ---
venv/
env/
ENV/
.venv/
.venv*/

# --- Python Tooling Caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Environment Variables ---
.env
.env.*
!.env.example
.env.local
env.example

# --- Data Files ---
*.csv
*.xlsx
*.xls
!requirements.txt

# --- Model Files ---
*.pkl
*.h5
*.model

# --- Logs ---
*.log

# --- Generated reports ---
reports/*
!reports/.gitkeep

# --- OS ---
.DS_Store
Thumbs.db

# --- Project Specific ---
data/*.csv
data/*.json
!data/.gitkeep
# v2 pipeline outputs / large backfill outputs
/data/v2/
/data/backfill_sofascore_10y/
/tests/fixtures/sofascore_*.json
# lineup 為執行期產物，預設不追蹤；保留 .gitkeep 維持資料夾
/data/lineup/*
!/data/lineup/.gitkeep
Betting_Records*.xlsx
xgb_model.pkl
archive/

# --- Large External Tools ---
TakeData/other/Football data crawling tool/
OddsHarvester/node_modules/
OddsHarvester/*.log
# --- Local release bundles / cloned tools ---
release/
TakeData/OddsHarvester/
data/magisk_modules/

# --- Local bootstrap artifacts ---
get-pip.py
# Local dev / CI artifacts
logs/

# Virtualenvs
.venv/
.venv*/

# Python cache
__pycache__/
*.pyc

# Local env
.env
